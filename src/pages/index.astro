---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryExplorer from '../components/GalleryExplorer.jsx';

export const prerender = true;
---

<BaseLayout
  title="Event Gallery"
  description="Browse event photography by event name, type, and date."
>
  <main class="mx-auto min-h-screen w-full max-w-[1600px] px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
    <header class="mb-8 max-w-3xl md:mb-10">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--muted)]">Event photography</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Moments, organized.</h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-[var(--muted)] sm:text-lg">
        Search the gallery by event, category, or date. Images are delivered responsively through Cloudinary.
      </p>
    </header>

    <GalleryExplorer client:load />
  </main>
</BaseLayout>
